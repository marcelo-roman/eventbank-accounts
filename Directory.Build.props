<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1062;CS1591;NU1507</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <EventBankLocalFeed>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../.feed'))</EventBankLocalFeed>
    <RestoreAdditionalProjectSources Condition="Exists('$(EventBankLocalFeed)')">$(EventBankLocalFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
